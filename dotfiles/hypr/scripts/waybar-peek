#!/usr/bin/env bash
set -u

SECS="${1:-0.6}"
RUNTIME="${XDG_RUNTIME_DIR:-/tmp}"
DEADLINE_FILE="$RUNTIME/doiz-waybar-peek.deadline"
LOCK_FILE="$RUNTIME/doiz-waybar-peek.lock"

WAYBAR_OFF_FLAG="${XDG_STATE_HOME:-$HOME/.local/state}/doiz/waybar-off"
[ -e "$WAYBAR_OFF_FLAG" ] && exit 0

PIDS="$(pgrep -x waybar 2>/dev/null)"
[ -n "$PIDS" ] || exit 0

now_ms() { date +%s%3N; }

ms="$(awk -v s="$SECS" 'BEGIN { if (s + 0 < 0.1) s = 0.1; if (s + 0 > 10) s = 10; printf "%d", s * 1000 }')"
echo $(( $(now_ms) + ms )) > "$DEADLINE_FILE"

exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

for pid in $PIDS; do kill -USR1 "$pid" 2>/dev/null; done

while :; do
    deadline="$(cat "$DEADLINE_FILE" 2>/dev/null || echo 0)"
    [ "$(now_ms)" -ge "$deadline" ] && break
    sleep 0.05
done

alive="$(pgrep -x waybar 2>/dev/null)"
for pid in $PIDS; do
    case " $(echo $alive) " in
        *" $pid "*) kill -USR1 "$pid" 2>/dev/null ;;
    esac
done

rm -f "$DEADLINE_FILE"
