{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin": "6px 8px 0px 8px",
    "spacing": 0,
    "reload_style_on_change": true,

    "modules-left": [
        "clock",
        "custom/separator",
        "hyprland/workspaces"
    ],

    "modules-center": [
        "clock#date",
        "custom/weather",
        "cava",
        "mpris"
    ],

    "modules-right": [
        "tray",
        "cpu",
        "temperature",
        "memory",
        "custom/disk",
        "network",
        "backlight",
        "pulseaudio",
        "battery",
        "custom/controlcenter"
    ],

    "clock": {
        "format": "{:%H:%M}",
        "interval": 15,
        "tooltip": false
    },

    "custom/separator": {
        "format": "",
        "tooltip": false
    },

    "clock#date": {
        "format": "{:%a %d %b}",
        "interval": 60,
        "tooltip": true,
        "tooltip-format": "{calendar}",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "left",
            "format": {
                "months": "<b>{}</b>",
                "days": "{}",
                "weekdays": "<b>{}</b>",
                "today": "<span color='#1A1D33' background='#6D72A8'><b>{}</b></span>"
            }
        }
    },

    "custom/weather": {
        "format": "{}",
        "exec": "bash \"$HOME/.config/waybar/scripts/weather.sh\"",
        "return-type": "json",
        "interval": 1800,
        "tooltip": true
    },

    "cava": {
        "cava_config": "$HOME/.config/cava/config_waybar",
        "framerate": 60,
        "bars": 12,
        "input_delay":4 ,
        "bar_delimiter": 0,
        "hide_on_silence": false,
        "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
        "tooltip": false
    },

    "mpris": {
        "format": "{status_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "format-stopped": "",
        "status-icons": {
            "playing": "󰐊",
            "paused": "󰏤"
        },
        "dynamic-order": ["title", "artist"],
        "dynamic-separator": " - ",
        "dynamic-len": 40,
        "max-length": 42,
        "ellipsis": "…",
        "tooltip": false,
        "on-click": "qs -c mediapopup ipc call mediapopup toggle || qs -c mediapopup -n &",
        "on-click-right": "playerctl play-pause",
        "on-click-middle": "playerctl next"
    },

    "hyprland/workspaces": {
        "disable-scroll": true,
        "disable-click": false,
        "all-outputs": true,
        "active-only": false,
        "sort-by-number": true,
        "format": "{icon}",
        "format-icons": {
            "default": "●",
            "active": "●",
            "urgent": "●"
        },
        "persistent-workspaces": {
            "*": 10
        }
    },

    "tray": {
        "icon-size": 13,
        "spacing": 7
    },

    "cpu": {
        "format": "󰍛 {usage}%",
        "interval": 3,
        "tooltip": false,
        "on-click": "kitty btop"
    },

    "temperature": {
        "format": "󰾆 {temperatureC}°",
        "critical-threshold": 80,
        "interval": 5,
        "tooltip": false,
        "on-click": "kitty btop"
    },

    "memory": {
        "format": "󰘚 {percentage}%",
        "interval": 5,
        "tooltip": false,
        "on-click": "kitty btop"
    },

    "custom/disk": {
        "exec": "bash -c 'd=$(findmnt -n -o SOURCE --target / | cut -d\"[\" -f1); r=$(lsblk -s -n -r -o ROTA \"$d\" 2>/dev/null | tail -n1); case \"$r\" in 0) l=SSD;; 1) l=HDD;; *) l=DISK;; esac; echo \"$l $(df --output=pcent / | tail -n1 | tr -d \" %\")%\"'",
        "format": "󰋊 {}",
        "interval": 60,
        "tooltip": false,
        "on-click": "kitty btop"
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀",
        "format-disconnected": "󰖪",
        "format-disabled": "󰖪",
        "interval": 30,
        "tooltip": false,
        "on-click": "qs -c network ipc call network toggle || qs -c network -n &"
    },

    "backlight": {
        "format": "󰃠 {percent}%",
        "interval": 30,
        "tooltip": false,
        "on-scroll-up": "brightnessctl set 5%+",
        "on-scroll-down": "brightnessctl set 5%-",
        "on-click": "qs -c brightness ipc call brightness toggle || qs -c brightness -n &"
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰖁",
        "tooltip": false,
        "on-click": "qs -c volume ipc call volume toggle || qs -c volume -n &"
    },

    "battery": {
        "format": "󰁹 {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-full": "󰁹 {capacity}%",
        "interval": 60,
        "on-click": "qs -c battery ipc call battery toggle || qs -c battery -n &",
        "tooltip": false
    },

    "custom/controlcenter": {
        "format": "󰕮",
        "tooltip": false,
        "on-click": "bash \"$HOME/.config/hypr/scripts/doiz-controlcenter\" ipc call controlcenter toggle",
        "on-click-right": "qs -c settings ipc call settings toggle || qs -c settings -n &"
    }
}
