* {
    border: none;
    border-radius: 0;
    min-height: 0;
    font-family: "JetBrainsMono Nerd Font";
    font-size: 10px;
    font-weight: 600;
    transition: background-color 120ms ease, color 120ms ease;
}

window#waybar {
    background: transparent;
    color: @FOREGROUND@;
}

.modules-left,
.modules-center,
.modules-right {
    background: @BACKGROUND_ALPHA@;
    border-radius: 4px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.20);
    padding: 0 7px;
}

#clock {
    color: @FOREGROUND@;
    font-weight: 700;
    padding: 0 7px;
    margin-right: 4px;
}

#clock.date {
    color: @ACCENT_ALT@;
    margin-right: 0;
}

#clock:hover {
    color: @BACKGROUND@;
    background: @ACCENT_ALT_ALPHA@;
    border-radius: 7px;
    padding-left: 12px;
    padding-right: 12px;
}

#custom-separator {
    min-width: 12px;
    min-height: 12px;
    margin: 0 6px;
    padding: 0;
    background-color: transparent;
    border: 1.5px solid @ACCENT_ALT@;
    border-radius: 50%;
}

#custom-separator:hover {
    border-color: @ACCENT@;
}

#workspaces {
    margin-left: 3px;
    padding: 3px 4px;
    background: transparent;
}

#workspaces button,
#workspaces button.empty,
#workspaces button.visible,
#workspaces button.persistent,
#workspaces button:not(.active):not(.urgent) {
    min-width: 8px;
    min-height: 8px;
    padding: 0 4px;
    margin: 0 2px;
    color: @MUTED@;
    background-color: transparent;
    background-image: none;
    border: none;
    border-radius: 5px;
    opacity: 0.75;
    outline: none;
    box-shadow: none;
    text-shadow: none;
}

#workspaces button.active {
    min-width: 28px;
    color: @BACKGROUND@;
    background-color: @ACCENT_ALT@;
    opacity: 1;
    border-radius: 6px;
    box-shadow: none;
    text-shadow: none;
}

#workspaces button.urgent {
    min-width: 18px;
    background-color: @RED@;
    color: @BACKGROUND@;
    opacity: 1;
    box-shadow: none;
    text-shadow: none;
}

#workspaces button:not(.active):not(.urgent):hover {
    min-width: 20px;
    color: @FOREGROUND@;
    background-color: @ACCENT_ALT_HOVER@;
    opacity: 1;
    box-shadow: none;
}

#workspaces button.active:hover {
    min-width: 34px;
    background-color: @ACCENT@;
}

#custom-weather {
    padding: 0 7px;
    margin: 0 2px;
    color: @ACCENT@;
    background: transparent;
    border-radius: 7px;
    font-weight: 700;
}

#custom-weather:hover {
    color: @BACKGROUND@;
    background: @ACCENT_ALT_ALPHA@;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 7px;
}

#custom-weather.unavailable {
    color: @MUTED@;
}

#cava {
    min-width: 80px;
    padding: 2px 6px;
    margin: 0 2px;
    color: @ACCENT@;
    background: transparent;
    border-radius: 999px;
    letter-spacing: 0;
    font-family: "JetBrainsMono Nerd Font";
    font-size: 10px;
    font-weight: 700;
    transition: background-color 120ms ease, color 120ms ease;
}

#cava:hover {
    color: @ACCENT@;
    background: transparent;
    border-radius: 999px;
}

#cava:active {
    color: @BACKGROUND@;
    background: @ACCENT@;
    border-radius: 999px;
    padding: 2px 10px;
}

#cava.silent {
    opacity: 0;
}

#tray,
#cpu,
#temperature,
#memory,
#custom-disk,
#network,
#backlight,
#pulseaudio,
#battery,
#custom-controlcenter {
    padding: 0 6px;
    margin: 0 1px;
    color: @SUBTEXT@;
    border-radius: 7px;
}

#tray {
    padding-left: 5px;
    padding-right: 5px;
}

#tray > .passive {
    -gtk-icon-effect: none;
}

#tray > .needs-attention {
    opacity: 1;
}

#cpu {
    color: @BLUE@;
}

#temperature {
    color: @CYAN@;
}

#memory {
    color: @ACCENT_ALT@;
}

#custom-disk {
    color: @MUTED@;
}

#network {
    color: @ACCENT_ALT@;
}

#battery {
    color: @SUBTEXT@;
}

#mpris {
    color: @ACCENT@;
    font-weight: 700;
    padding: 0 8px;
    border-radius: 7px;
}

#mpris.playing {
    color: @ACCENT@;
}

#mpris.paused {
    color: @MUTED@;
}

#mpris.stopped {
    color: @MUTED@;
}

#mpris:hover {
    color: @BACKGROUND@;
    background: @ACCENT_ALT_ALPHA@;
}

#cpu:hover,
#temperature:hover,
#memory:hover,
#custom-disk:hover,
#network:hover,
#backlight:hover,
#pulseaudio:hover,
#battery:hover,
#custom-controlcenter:hover,
#tray:hover {
    color: @BACKGROUND@;
    background: @ACCENT_ALT_ALPHA@;
    padding-left: 10px;
    padding-right: 10px;
    border-radius: 7px;
}

#temperature.critical {
    color: @RED@;
}

#battery.warning {
    color: @YELLOW@;
}

#battery.critical {
    color: @RED@;
    font-weight: 800;
}

#battery.charging {
    color: @GREEN@;
}

tooltip {
    background: @BACKGROUND_TOOLTIP@;
    border: 1px solid @ACCENT_ALPHA@;
    border-radius: 4px;
    color: @FOREGROUND@;
    padding: 9px 11px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.35);
}

tooltip label {
    color: @FOREGROUND@;
    font-family: "JetBrainsMono Nerd Font";
    font-size: 10px;
    font-weight: 600;
}
