@define-color doiz_bg      @BACKGROUND@;
@define-color doiz_fg      @FOREGROUND@;
@define-color doiz_sub     @SUBTEXT@;
@define-color doiz_muted   @MUTED@;
@define-color doiz_accent  @ACCENT@;
@define-color doiz_accent2 @ACCENT_ALT@;
@define-color doiz_surface @SURFACE@;

window.thunar,
.thunar window,
window.background.thunar {
    background-color: @BG_WINDOW@;
    color: @FOREGROUND@;
    border-radius: 14px;
    border: 1px solid @BORDER@;
}

.thunar,
.thunar .background,
.thunar paned,
.thunar box {
    background-color: transparent;
    color: @FOREGROUND@;
}

.thunar menubar,
.thunar menubar > menuitem {
    background: transparent;
    color: @FOREGROUND@;
    border: none;
    padding: 2px 6px;
}
.thunar menubar > menuitem:hover {
    background-color: @ACCENT_ALPHA@;
    border-radius: 8px;
}

menu, .popup menu, .thunar menu {
    background-color: @BG_POPUP@;
    color: @FOREGROUND@;
    border: 1px solid @BORDER@;
    border-radius: 10px;
    padding: 4px;
}
menu menuitem { border-radius: 6px; padding: 4px 8px; }
menu menuitem:hover { background-color: @ACCENT_ALPHA@; }

.thunar toolbar,
.thunar .toolbar {
    background: transparent;
    border: none;
    padding: 6px 10px;
}
.thunar toolbar button,
.thunar toolbar .flat {
    background: transparent;
    border: none;
    border-radius: 999px;
    min-width: 34px;
    min-height: 34px;
    color: @FOREGROUND@;
}
.thunar toolbar button:hover { background-color: @ACCENT_ALPHA@; }
.thunar toolbar button:active,
.thunar toolbar button:checked { background-color: @ACCENT_STRONG@; }

.thunar entry,
.thunar .path-bar,
.thunar toolbar entry {
    background-color: @BG_FIELD@;
    color: @FOREGROUND@;
    caret-color: @FOREGROUND@;
    border: none;
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 26px;
    box-shadow: none;
}
.thunar entry:focus { box-shadow: inset 0 0 0 1px @ACCENT_ALT@; }

.thunar .sidebar,
.thunar .sidebar row,
.thunar .sidebar treeview,
.thunar .sidebar treeview.view {
    background-color: transparent;
    color: @FOREGROUND@;
}
.thunar .sidebar treeview.view:selected,
.thunar .sidebar row:selected {
    background-color: @BG_SELECT@;
    color: @FOREGROUND@;
    border-radius: 10px;
}
.thunar .sidebar treeview.view:hover {
    background-color: @ACCENT_ALPHA@;
    border-radius: 10px;
}
.thunar .sidebar treeview.view.header,
.thunar .sidebar .dim-label { font-weight: bold; color: @FOREGROUND@; }

.thunar scrolledwindow,
.thunar .view,
.thunar iconview,
.thunar treeview.view {
    background-color: @BG_CONTENT@;
    color: @FOREGROUND@;
    border-radius: 12px;
}
.thunar iconview:selected,
.thunar .view:selected,
.thunar treeview.view:selected {
    background-color: @BG_SELECT@;
    color: @FOREGROUND@;
    border-radius: 10px;
}
.thunar rubberband {
    background-color: @ACCENT_ALPHA@;
    border: 1px solid @ACCENT_ALT@;
    border-radius: 4px;
}

.thunar statusbar {
    background-color: @BG_CONTENT@;
    color: @SUBTEXT@;
    border-radius: 10px;
    margin: 6px 10px 10px 10px;
    padding: 6px 12px;
}

.thunar scrollbar { background: transparent; border: none; }
.thunar scrollbar slider {
    background-color: @MUTED_ALPHA@;
    border-radius: 999px;
    min-width: 6px;
    min-height: 6px;
    border: 2px solid transparent;
}
.thunar scrollbar slider:hover { background-color: @ACCENT_ALT@; }

* {
    transition: none;
    animation: none;
}
