[general]

framerate = 60
autosens = 1
sensitivity = 180
bars = 12


[input]

method = pipewire
source = auto


[output]

method = raw
raw_target = /tmp/cava.fifo
data_format = ascii
ascii_max_range = 8
bar_delimiter = 59
frame_delimiter = 10


[smoothing]

monstercat = 1
waves = 0
noise_reduction = 60


[color]

background = '#0B0D17'
foreground = '#CBA6F7'